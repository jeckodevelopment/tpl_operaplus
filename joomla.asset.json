{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "operaplus",
  "version": "2.0.0-rc.2",
  "description": "Opera+ Joomla template assets",
  "assets": [
    {
      "name": "template.operaplus",
      "type": "style",
      "uri": "template.css"
    },
    {
      "name": "template.operaplus",
      "type": "script",
      "uri": "template.js",
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "template.operaplus.magazine",
      "type": "style",
      "uri": "magazine.css",
      "dependencies": [
        "template.operaplus"
      ]
    }
  ]
}
