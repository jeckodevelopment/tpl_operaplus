<?xml version='1.0' encoding='utf-8'?>
<extension type="template" client="site" method="upgrade">
  <name>operaplus</name>
  <version>2.0.0-rc.10</version>
  <creationDate>2026-11-26</creationDate>
  <author>Jecko Development</author>
  <authorUrl>https://jeckodevelopment.com</authorUrl>
  <copyright>Copyright (C) Opera+</copyright>
  <license>GNU General Public License version 2 or later</license>
  <description>TPL_OPERAPLUS_XML_DESCRIPTION</description>
  <inheritable>1</inheritable>
  <scriptfile>script.php</scriptfile>
  <files>
    <filename>script.php</filename>
    <filename>index.php</filename>
    <filename>component.php</filename>
    <filename>error.php</filename>
    <filename>offline.php</filename>
    <filename>joomla.asset.json</filename>
    <filename>templateDetails.xml</filename>
    <filename>GUIDA_STILI.md</filename>
    <filename>README.md</filename>
    <filename>CHANGELOG.md</filename>
    <folder>html</folder>
    <folder>field</folder>
    <folder>language</folder>
  </files>
  <media destination="templates/site/operaplus" folder="media">
    <folder>css</folder>
    <folder>js</folder>
    <folder>images</folder>
  </media>
  <positions>
    <position>topbar</position>
    <position>header-actions</position>
    <position>menu</position>
    <position>hero</position>
    <position>hero-side</position>
    <position>announcement</position>
    <position>breadcrumb</position>
    <position>search</position>
    <position>intro</position>
    <position>content-highlights</position>
    <position>mission</position>
    <position>featured</position>
    <position>story</position>
    <position>courses</position>
    <position>partners</position>
    <position>schools</position>
    <position>association</position>
    <position>contacts</position>
    <position>main-top</position>
    <position>sidebar-left</position>
    <position>sidebar-right</position>
    <position>main-bottom</position>
    <position>pre-footer</position>
    <position>bottom</position>
    <position>footer</position>
    <position>footer-social</position>
    <position>footer-brand</position>
    <position>footer-links</position>
    <position>footer-legal</position>
    <position>magazine-cover</position>
    <position>magazine-news</position>
    <position>magazine-featured</position>
    <position>magazine-featured-aside</position>
    <position>magazine-reviews</position>
    <position>magazine-reviews-aside</position>
    <position>magazine-interviews</position>
    <position>magazine-interviews-aside</position>
    <position>magazine-dossier</position>
    <position>magazine-dossier-aside</position>
    <position>magazine-insights</position>
    <position>magazine-insights-aside</position>
    <position>magazine-latest</position>
    <position>magazine-latest-aside</position>
    <position>magazine-sidebar</position>
    <position>debug</position>
  </positions>
  <languages folder="language">
    <language tag="it-IT">it-IT/tpl_operaplus.ini</language>
    <language tag="it-IT">it-IT/tpl_operaplus.sys.ini</language>
    <language tag="en-GB">en-GB/tpl_operaplus.ini</language>
    <language tag="en-GB">en-GB/tpl_operaplus.sys.ini</language>
  </languages>
  <updateservers>
    <server type="extension" priority="1" name="Opera+ Template — Stable">https://raw.githubusercontent.com/jeckodevelopment/tpl_operaplus/main/updates/stable.xml</server>
  </updateservers>
  <config>
    <fields name="params">
      <fieldset name="branding" label="TPL_OPERAPLUS_BRANDING">
        <field name="logo" type="media" label="TPL_OPERAPLUS_LOGO" directory="images" />
        <field name="faviconFile" type="media" label="TPL_OPERAPLUS_FAVICON" description="TPL_OPERAPLUS_FAVICON_DESC" types="images,documents" preview="true" />
        <field name="faviconPath" type="text" label="TPL_OPERAPLUS_FAVICON_PATH" description="TPL_OPERAPLUS_FAVICON_PATH_DESC" filter="string" />
        <field name="defaultOgImage" type="media" label="TPL_OPERAPLUS_OG_IMAGE" description="TPL_OPERAPLUS_OG_IMAGE_DESC" types="images" preview="true" />
        <field name="brandText" type="text" label="TPL_OPERAPLUS_BRAND_TEXT" default="Opera+" filter="string" />
        <field name="tagline" type="text" label="TPL_OPERAPLUS_TAGLINE" default="L'opera lirica raccontata al grande pubblico" filter="string" />
        <field name="heroLogo" type="media" label="TPL_OPERAPLUS_ADMIN_HERO_LOGO" description="TPL_OPERAPLUS_ADMIN_HERO_LOGO_DESC" directory="images" />
        <field name="footerLogo" type="media" label="TPL_OPERAPLUS_ADMIN_FOOTER_LOGO" description="TPL_OPERAPLUS_ADMIN_FOOTER_LOGO_DESC" directory="images" />
        <field name="footerHeading" type="text" label="TPL_OPERAPLUS_ADMIN_FOOTER_HEADING" default="Associazione Opera+" filter="string" />
        <field name="footerTaxId" type="text" label="TPL_OPERAPLUS_ADMIN_FOOTER_TAX_ID" default="97925160018" filter="string" />
        <field name="footerAddress" type="text" label="TPL_OPERAPLUS_ADMIN_FOOTER_ADDRESS" default="via Federico Patetta 12, 10155 Torino" filter="string" />
        <field name="footerEmail" type="email" label="TPL_OPERAPLUS_ADMIN_FOOTER_EMAIL" default="info@opera.plus" />
        <field name="footerPec" type="email" label="TPL_OPERAPLUS_ADMIN_FOOTER_PEC" default="operaplus@pec.it" />
        <field name="footerTopLabel" type="text" label="TPL_OPERAPLUS_ADMIN_FOOTER_TOP_LABEL" default="Torna all’inizio ↑" filter="string" />
        <field name="footerText" type="textarea" label="TPL_OPERAPLUS_ADMIN_FOOTER_TEXT" default="Opera+ · L’opera lirica raccontata al grande pubblico" filter="string" />
      </fieldset>
      <fieldset name="appearance" label="TPL_OPERAPLUS_APPEARANCE">
        <field name="externalFont" type="list" label="TPL_OPERAPLUS_FONT_MODE" description="TPL_OPERAPLUS_FONT_MODE_DESC" default="auto" validate="options"><option value="auto">TPL_OPERAPLUS_FONT_AUTO</option><option value="system">TPL_OPERAPLUS_FONT_SYSTEM</option><option value="google">TPL_OPERAPLUS_FONT_GOOGLE</option></field>
        <field name="pageTheme" type="list" label="TPL_OPERAPLUS_ADMIN_PAGE_THEME" description="TPL_OPERAPLUS_ADMIN_PAGE_THEME_DESC" default="light">
          <option value="dark">TPL_OPERAPLUS_ADMIN_PAGE_THEME_DARK</option>
          <option value="light">TPL_OPERAPLUS_ADMIN_PAGE_THEME_LIGHT</option>
        </field>
        <field name="accent" type="color" label="TPL_OPERAPLUS_ACCENT" default="#b78e63" />
        <field name="background" type="color" label="TPL_OPERAPLUS_BACKGROUND" default="#171316" />
        <field name="containerWidth" type="number" label="TPL_OPERAPLUS_CONTAINER" default="1200" min="900" max="1600" step="20" />
        <field name="burgundy" type="color" label="TPL_OPERAPLUS_ADMIN_BURGUNDY" default="#632b3a" />
        <field name="ivory" type="color" label="TPL_OPERAPLUS_ADMIN_IVORY" default="#f3ece1" />
        <field name="showHomeComponent" type="radio" label="TPL_OPERAPLUS_ADMIN_SHOW_HOME_COMPONENT" default="0">
          <option value="1">JYES</option>
          <option value="0">JNO</option>
        </field>
        <field name="stickyHeader" type="radio" label="TPL_OPERAPLUS_STICKY" default="1">
          <option value="1">JYES</option>
          <option value="0">JNO</option>
        </field>
        <field name="presentationMode" type="opstylemode" default="standard" required="true" />
        <field name="magazineSection" type="note" label="TPL_OPERAPLUS_MAGAZINE" showon="presentationMode:magazine" />
        <field name="magazineHomeMenu" type="menuitem" label="TPL_OPERAPLUS_MAG_HOME_MENU" description="TPL_OPERAPLUS_MAG_HOME_MENU_DESC" default="0" showon="presentationMode:magazine" />
        <field name="magazineTitle" type="text" label="TPL_OPERAPLUS_MAG_TITLE" default="Magazine" filter="string" showon="presentationMode:magazine" />
        <field name="magazineSubtitle" type="text" label="TPL_OPERAPLUS_MAG_SUBTITLE" filter="string" showon="presentationMode:magazine" />
        <field name="magazineBanner" type="media" label="TPL_OPERAPLUS_MAG_BANNER" types="images" directory="images" preview="true" showon="presentationMode:magazine" />
        <field name="magazineShowComponent" type="radio" label="TPL_OPERAPLUS_MAG_COMPONENT" default="0" showon="presentationMode:magazine">
          <option value="1">JYES</option>
          <option value="0">JNO</option>
        </field>
        <field name="magazineReadingTime" type="radio" label="TPL_OPERAPLUS_MAG_READING_TIME" default="1" showon="presentationMode:magazine"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="magazineReadingSpeed" type="number" label="TPL_OPERAPLUS_MAG_READING_SPEED" default="200" min="50" max="1000" step="10" filter="integer" showon="presentationMode:magazine" />
        <field name="magazineImageRatio" type="list" label="TPL_OPERAPLUS_MAG_RATIO" description="TPL_OPERAPLUS_MAG_RATIO_DESC" default="classic" validate="options" showon="presentationMode:magazine"><option value="classic">16:10</option><option value="wide">16:9</option><option value="square">1:1</option></field>
        <field name="magazineOverlay" type="list" label="TPL_OPERAPLUS_MAG_OVERLAY" default="classic" validate="options" showon="presentationMode:magazine"><option value="classic">TPL_OPERAPLUS_MAG_OVERLAY_CLASSIC</option><option value="strong">TPL_OPERAPLUS_MAG_OVERLAY_STRONG</option></field>
        <field name="magazineSeparators" type="radio" label="TPL_OPERAPLUS_MAG_SEPARATORS" default="1" validate="options" showon="presentationMode:magazine"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="magazineTintFirst" type="radio" label="TPL_OPERAPLUS_MAG_TINT_FIRST" default="0" showon="presentationMode:magazine"><option value="1">JYES</option><option value="0">JNO</option></field>
      </fieldset>
      <fieldset name="typography" label="TPL_OPERAPLUS_ADMIN_TYPOGRAPHY">
        <field name="h1Size" type="list" label="TPL_OPERAPLUS_ADMIN_H1_SIZE" default="48">
          <option value="40">40 px</option>
          <option value="48">48 px</option>
          <option value="56">56 px</option>
          <option value="64">64 px</option>
          <option value="72">72 px</option>
          <option value="80">80 px</option>
        </field>
        <field name="h2Size" type="list" label="TPL_OPERAPLUS_ADMIN_H2_SIZE" default="43">
          <option value="28">28 px</option>
          <option value="32">32 px</option>
          <option value="36">36 px</option>
          <option value="40">40 px</option>
          <option value="43">43 px</option>
          <option value="48">48 px</option>
          <option value="56">56 px</option>
        </field>
        <field name="h3Size" type="list" label="TPL_OPERAPLUS_ADMIN_H3_SIZE" default="28">
          <option value="20">20 px</option>
          <option value="24">24 px</option>
          <option value="28">28 px</option>
          <option value="32">32 px</option>
          <option value="36">36 px</option>
        </field>
        <field name="h4Size" type="list" label="TPL_OPERAPLUS_ADMIN_H4_SIZE" default="23">
          <option value="18">18 px</option>
          <option value="20">20 px</option>
          <option value="23">23 px</option>
          <option value="26">26 px</option>
          <option value="30">30 px</option>
        </field>
        <field name="h5Size" type="list" label="TPL_OPERAPLUS_ADMIN_H5_SIZE" default="19">
          <option value="15">15 px</option>
          <option value="17">17 px</option>
          <option value="19">19 px</option>
          <option value="21">21 px</option>
          <option value="24">24 px</option>
        </field>
        <field name="heroH1Size" type="list" label="TPL_OPERAPLUS_ADMIN_HERO_H1_SIZE" default="72">
          <option value="48">48 px</option>
          <option value="56">56 px</option>
          <option value="64">64 px</option>
          <option value="72">72 px</option>
          <option value="80">80 px</option>
          <option value="88">88 px</option>
        </field>
      </fieldset>
      <fieldset name="navigation" label="TPL_OPERAPLUS_ADMIN_NAVIGATION">
        <field name="megaWidth" type="list" label="TPL_OPERAPLUS_ADMIN_MEGA_WIDTH" description="TPL_OPERAPLUS_ADMIN_MEGA_WIDTH_DESC" default="760">
          <option value="600">TPL_OPERAPLUS_ADMIN_MEGA_WIDTH_600</option>
          <option value="760">TPL_OPERAPLUS_ADMIN_MEGA_WIDTH_760</option>
          <option value="960">TPL_OPERAPLUS_ADMIN_MEGA_WIDTH_960</option>
          <option value="1100">TPL_OPERAPLUS_ADMIN_MEGA_WIDTH_1100</option>
        </field>
        <field name="megaColumns" type="list" label="TPL_OPERAPLUS_ADMIN_MEGA_COLUMNS" default="3">
          <option value="2">TPL_OPERAPLUS_ADMIN_MEGA_COLUMNS_2</option>
          <option value="3">TPL_OPERAPLUS_ADMIN_MEGA_COLUMNS_3</option>
          <option value="4">TPL_OPERAPLUS_ADMIN_MEGA_COLUMNS_4</option>
        </field>
        <field name="menuMode" type="list" label="TPL_OPERAPLUS_ADMIN_MENU_MODE" description="TPL_OPERAPLUS_ADMIN_MENU_MODE_DESC" default="hover">
          <option value="hover">TPL_OPERAPLUS_ADMIN_MENU_MODE_HOVER</option>
          <option value="click">TPL_OPERAPLUS_ADMIN_MENU_MODE_CLICK</option>
        </field>
      </fieldset>
      <fieldset name="documentation" label="TPL_OPERAPLUS_ADMIN_DOCUMENTATION">
        <field name="opDocTopic01" type="note" class="alert alert-info" label="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC01" description="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC01_DESC" />
        <field name="opDocTopic02" type="note" class="alert alert-info" label="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC02" description="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC02_DESC" />
        <field name="opDocTopic03" type="note" class="alert alert-info" label="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC03" description="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC03_DESC" />
        <field name="opDocTopic04" type="note" class="alert alert-info" label="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC04" description="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC04_DESC" />
        <field name="opDocTopic05" type="note" class="alert alert-info" label="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC05" description="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC05_DESC" />
        <field name="opDocTopic06" type="note" class="alert alert-info" label="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC06" description="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC06_DESC" />
        <field name="opDocTopic07" type="note" class="alert alert-info" label="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC07" description="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC07_DESC" />
        <field name="opDocTopic08" type="note" class="alert alert-info" label="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC08" description="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC08_DESC" />
        <field name="opDocTopic09" type="note" class="alert alert-info" label="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC09" description="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC09_DESC" />
        <field name="opDocTopic10" type="note" class="alert alert-info" label="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC10" description="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC10_DESC" />
        <field name="opDocTopic11" type="note" class="alert alert-info" label="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC11" description="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC11_DESC" />
        <field name="opDocTopic12" type="note" class="alert alert-info" label="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC12" description="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC12_DESC" />
        <field name="opDocTopic13" type="note" class="alert alert-info" label="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC13" description="TPL_OPERAPLUS_ADMIN_OP_DOC_TOPIC13_DESC" />
      </fieldset>
    </fields>
  </config>
</extension>